# apps/babywarmer/scripts/boot -- the babywarmer, wired from programs and devices
#
# /fram/boot replaces this script when it exists. The safety is not here:
# the guard (dev/guard.cpp) is a kernel task that owns the safety relay, the
# alarm conditions and the power when the skin reading can't be trusted,
# whether or not these jobs run.
#
#   skin --> pid (feed-forward + PID) --> select by phase --> follow --> heater
#   room --> fftable --------^             (boost 80, coast 0)   ^
#                                                   manual % ----'

date
toggle /dev/buttons/lamp /dev/lamp &

# The buttons: MANUAL switches auto/manual; UP/DOWN step the setpoint by
# 0.5 C (auto) or the manual power by 5 % (manual).
toggle /dev/buttons/manual /dev/heaterauto &
adjust /dev/heaterauto /dev/setpoint /dev/percent 0.5 5 &

# The control: phase sets idle/boost/coast/pid/safe once a second; the PID
# runs on the feed-forward for the room; select turns the phase into the
# auto power (in safe: what the guard heats with, so the PID takes over
# from that power when the guard says ok again); follow sends the auto or
# the manual power to the heater.
phase &
cat /dev/ambient | fftable > /dev/ffpower &
cat /dev/skintemp | pid /dev/state pid /dev/setpoint /dev/ffpower > /dev/pidout &
select /dev/state boost=80 coast=0 pid=/dev/pidout safe=/dev/heater > /dev/autopower &
follow /dev/heaterauto /dev/autopower /dev/percent /dev/heater &

# What the nurse sees: the skin temperature; the setpoint, the manual %, or
# in safe the power the guard heats with; the buzzer (MUTE: quiet for a
# minute); the front-panel LEDs; the TFT (START starts the APGAR clock).
cat /dev/skintemp > /dev/seg7big &
select /dev/state idle=/dev/percent boost=/dev/setpoint coast=/dev/setpoint pid=/dev/setpoint safe=/dev/heater > /dev/seg7small &
alarm /dev/alarm/heater /dev/alarm/temphigh /dev/alarm/templow /dev/alarm/sensor &
ledwire &
tftwire &
